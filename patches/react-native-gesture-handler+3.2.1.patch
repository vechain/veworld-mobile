+// UIKit's insertSubview:atIndex: indexes into the layer's sublayers, which include _underlayLayer, so children
+// mounted after the first layout land one layer too low and draw under their earlier siblings.
+- (void)mountChildComponentView:(RNGHUIView *)childComponentView index:(NSInteger)index
+{
+  if (index < (NSInteger)self.subviews.count) {
+    [self insertSubview:childComponentView belowSubview:self.subviews[index]];
+  } else {
+    [self addSubview:childComponentView];
+  }
+}
