# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

fastlane_require "dotenv"

before_all do
	Dotenv.load ".env"
end

TEAM_ID = "RKZMX8AZ6P"
APP_IDENTIFIER = "org.vechain.veworld.app"
EXTENSION_IDENTIFIER = "org.vechain.veworld.app.OneSignalNotificationServiceExtension"
# Must match PROVISIONING_PROFILE_SPECIFIER in the Xcode project
APP_PROFILE_NAME = "VeWorld AppStore #{APP_IDENTIFIER}"
EXTENSION_PROFILE_NAME = "VeWorld AppStore #{EXTENSION_IDENTIFIER}"

def github_output(values)
  return unless ENV["GITHUB_OUTPUT"]
  File.open(ENV["GITHUB_OUTPUT"], "a") { |file| values.each { |key, value| file.puts("#{key}=#{value}") } }
end

default_platform(:ios)

platform :ios do

  lane :create_tags_gh do |values|
    build = values[:build]
    version = values[:version]

    add_git_tag(
      tag: "v#{version}-#{build}"
    )

    push_git_tags
  end


  private_lane :set_release_version do |options|
    version = options[:requested] || JSON.parse(File.read("../../package.json"))["version"]
    increment_version_number(version_number: version, xcodeproj: "VeWorld.xcodeproj")
  end

  # TestFlight lists every upload, including failed and processing ones, so its latest build is the one to beat.
  # Builds uploaded while the app belonged to another team are missing from that list but keep their numbers.
  private_lane :set_next_build_number do |options|
    latest = latest_testflight_build_number(api_key: options[:api_key], app_identifier: APP_IDENTIFIER)
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    recent = Spaceship::ConnectAPI.get_builds(filter: { app: app.id }, includes: nil, sort: "-uploadedDate", limit: 50).map { |build| build.version.to_i }
    increment_build_number(build_number: [latest.to_i, *recent].max + 1, xcodeproj: "VeWorld.xcodeproj")
  end

  # The distribution certificate lives in the ios-release environment; profiles are fetched (or created) on each run.
  private_lane :install_signing do |options|
    keychain = ENV.fetch("MATCH_KEYCHAIN_NAME")
    p12_data = Base64.decode64(ENV.fetch("IOS_DIST_CERT_P12_BASE64"))
    password = ENV.fetch("IOS_DIST_CERT_P12_PASSWORD")
    p12 = Tempfile.new(["distribution", ".p12"])
    File.binwrite(p12.path, p12_data)
    import_certificate(certificate_path: p12.path, certificate_password: password, keychain_name: keychain, keychain_password: "")
    p12.close!
    FastlaneCore::CertChecker.install_missing_wwdr_certificates(in_keychain: FastlaneCore::Helper.keychain_path(keychain))

    certificate = OpenSSL::PKCS12.new(p12_data, password).certificate.to_der
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: options[:api_key])
    { APP_IDENTIFIER => APP_PROFILE_NAME, EXTENSION_IDENTIFIER => EXTENSION_PROFILE_NAME }.each do |identifier, name|
      # sigh renames a new profile whose name is taken, which breaks PROVISIONING_PROFILE_SPECIFIER, so clear stale ones first.
      Spaceship::ConnectAPI::Profile.all(filter: { name: name }, includes: "certificates").each do |profile|
        next if profile.name != name || (profile.valid? && profile.certificates.any? { |c| Base64.decode64(c.certificate_content) == certificate })
        UI.important("Deleting profile #{profile.uuid} '#{name}': it cannot sign with the current certificate")
        profile.delete!
      end
      get_provisioning_profile(
        api_key: options[:api_key],
        app_identifier: identifier,
        provisioning_name: name,
        ignore_profiles_with_different_name: true,
      )
    end
  end

  # A wrong team prefix in application-identifier moves the default keychain group, so users lose their wallets.
  private_lane :verify_entitlements do |options|
    bundles = {
      "Payload/VeWorld.app" => [APP_IDENTIFIER, "../VeWorld/VeWorld.entitlements"],
      "Payload/VeWorld.app/PlugIns/OneSignalNotificationServiceExtension.appex" => [EXTENSION_IDENTIFIER, "../OneSignalNotificationServiceExtension/OneSignalNotificationServiceExtension.entitlements"],
    }
    Dir.mktmpdir do |dir|
      sh("unzip", "-q", options[:ipa], "-d", dir, log: false)
      bundles.each do |bundle, (identifier, source)|
        signed = Plist.parse_xml(IO.popen(["codesign", "-d", "--entitlements", "-", "--xml", File.join(dir, bundle)], err: File::NULL, &:read)) || {}
        problems = []
        problems << "application-identifier is #{signed["application-identifier"].inspect}" unless signed["application-identifier"] == "#{TEAM_ID}.#{identifier}"
        problems << "team-identifier is #{signed["com.apple.developer.team-identifier"].inspect}" unless signed["com.apple.developer.team-identifier"] == TEAM_ID
        Plist.parse_xml(source).each do |key, value|
          # Scalars such as aps-environment are rewritten from the profile, so only their presence is checked.
          next if signed.key?(key) && (!value.is_a?(Array) || Array(signed[key]).sort == value.sort)
          problems << "#{key} is #{signed[key].inspect}, expected #{value.inspect}"
        end
        UI.user_error!("#{bundle} entitlements: #{problems.join("; ")}") unless problems.empty?
      end
    end
    UI.success("Entitlements match team #{TEAM_ID}")
  end

  # Builds the app using specified options.
  #
  # @param optional {string} options[:version] - Version to release; defaults to package.json.
  desc "Push a new beta build to TestFlight"
  lane :build_ci do |options|
    setup_ci if ENV['CI']

    api_key = app_store_connect_api_key

    version = set_release_version(requested: options[:version])
    build = set_next_build_number(api_key: api_key)
    github_output(version: version, build: build)

    # clean build artifacts if any
    clean_build_artifacts

    clear_derived_data

    # update yarn packages and pods
    Dir.chdir "../.." do
      sh("yarn purge && yarn install:all")
    end


    install_signing(api_key: api_key)

    build_app(
      workspace: "VeWorld.xcworkspace",
      scheme: "VeWorld",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_IDENTIFIER => APP_PROFILE_NAME, EXTENSION_IDENTIFIER => EXTENSION_PROFILE_NAME },
      },
      clean: true,
      build_path: "./build",
      output_directory: "./build",
    )

    verify_entitlements(ipa: lane_context[SharedValues::IPA_OUTPUT_PATH])

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      apple_id: "6446854569",
      ipa: "./build/VeWorld.ipa",
    )

    # Nothing is committed, so the tag lands on the commit that was built.
    create_tags_gh(build:build, version:version)

    clean_build_artifacts
  end

  lane :build_test_ci do | options |
    store_password = ENV["STORE_PASSWORD"]
    key_password = ENV["KEY_PASSWORD"]
    key_alias = ENV["KEY_ALIAS"]
  
    version = options[:version_name]
    build = options[:version_code]
    github_username = options[:username]
    github_token = options[:token]

    ci_value = true

    setup_ci if ENV['CI']

    if !build.nil? 
      build = increment_build_number(build_number: build, xcodeproj: "VeWorld.xcodeproj")
              increment_build_number(build_number: build, xcodeproj: "VeWorld.xcodeproj")
    else
      build = increment_build_number(xcodeproj: "VeWorld.xcodeproj")
              increment_build_number(xcodeproj: "VeWorld.xcodeproj")
    end

    # check if spceicifed version number
    if !version.nil? 
      if version.downcase != "patch" && version.downcase != "minor" && version.downcase != "major"
        version = increment_version_number(version_number: version.downcase, xcodeproj: "VeWorld.xcodeproj")
                  increment_version_number(version_number: version.downcase, xcodeproj: "VeWorld.xcodeproj")
      else 
        version = increment_version_number(bump_type: version.downcase, xcodeproj: "VeWorld.xcodeproj")
                  increment_version_number(version_number: version.downcase, xcodeproj: "VeWorld.xcodeproj")
      end
    else
      version = get_version_number(xcodeproj: "VeWorld.xcodeproj")
    end
    
    ci_value = true
    sh("./set_ci_vars.sh #{ci_value}")
    sh("export SENTRY_DISABLE_AUTO_UPLOAD=true")
    
    clean_build_artifacts
    
    # update yarn packages and pods
    Dir.chdir "../.." do
      sh("yarn install:all")
    end
    
    sh "cd ../.. && pwd && npx react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle --assets-dest ios"
      # begin -> rescure == try -> catch
      begin
          xcodebuild(
          configuration: "Release",
          scheme:  "VeWorld",
          workspace: "VeWorld.xcworkspace",
          destination: "generic/platform=iOS Simulator",
          xcargs: "-quiet -sdk 'iphonesimulator' -destination 'generic/platform=iOS Simulator'",
          derivedDataPath: 'build'     
          )

      sh("echo 'Build successful'")

       # clean build artifacts if any
       clean_build_artifacts
    rescue => exception
      puts exception
  
      sh("echo 'Build failed'")
       # clean build artifacts if any
       clean_build_artifacts
    end
  end
end