{
    "extends": "@react-native/typescript-config",
    "compilerOptions": {
        "resolveJsonModule": true,
        "strict": true,
        "experimentalDecorators": true,
        "jsx": "react",
        "skipLibCheck": true,
        "types": ["node", "jest"],
        "esModuleInterop": true,
        "typeRoots": ["./node_modules/@types", "./src/@types"],
        "paths": {
            "~*": ["./src/*"],
            "~Api/*": ["./src/Api/*"],
            "~Storage/*": ["./src/Storage/*"],
            "~Model/*": ["./src/Model/*"],
            "~Services/*": ["./src/Services/*"],
            "~Screens/*": ["./src/Screens/*"],
            "~Navigation/*": ["./src/Navigation/*"],
            "~Constants/*": ["./src/Constants/*"],
            "~Hooks/*": ["./src/Hooks/*"],
            "~Utils/*": ["./src/Utils/*"],
            "~Components/*": ["./src/Components/*"],
            "~i18n/*": ["./src/i18n/*"],
            "~Assets/*": ["./src/Assets/*"],
            "~Networking/*": ["./src/Networking/*"],
            "~Events/*": ["./src/Events/*"],
            "~Test": ["./src/Test/index.tsx"],
            "~Logging/*": ["./src/Logging/*"],
            "~Generated/*": ["./src/Generated/*"],
            // view-shot's "react-native" export condition points at untyped TSX source,
            // which skipLibCheck does not cover. Type-check against its built types.
            "react-native-view-shot": ["./node_modules/react-native-view-shot/lib/index.d.ts"]
        }
    }
}
